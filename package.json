{
    "name": "sillytavern-serverless-edition",
    "version": "2.0.0-serverless.0",
    "description": "A single-Worker Cloudflare deployment of the SillyTavern interface and core features.",
    "type": "module",
    "license": "AGPL-3.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/ZUENS2020/SillyTavern-Serverless-Edition.git"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "node cloudflare/scripts/build-worker.mjs",
        "dev": "wrangler dev",
        "lint": "eslint \"public/**/*.js\" \"cloudflare/scripts/**/*.mjs\"",
        "lint:fix": "npm run lint -- --fix",
        "cf:generate-defaults": "node cloudflare/scripts/generate-defaults.mjs",
        "cf:generate-third-party": "node cloudflare/scripts/generate-third-party-catalog.mjs",
        "cf:types": "wrangler types src/worker/worker-configuration.d.ts",
        "check:worker": "tsc --noEmit -p tsconfig.worker.json",
        "check:browser-deps": "node cloudflare/scripts/check-browser-deps.mjs",
        "check:extension-policy": "node cloudflare/scripts/check-extension-policy.mjs",
        "check:worker-policy": "node cloudflare/scripts/check-worker-policy.mjs",
        "check:access-config": "node cloudflare/scripts/check-access-config.mjs",
        "test:worker": "vitest run",
        "test:production": "node cloudflare/scripts/e2e-production.mjs",
        "audit:routes": "node cloudflare/scripts/audit-routes.mjs",
        "audit:security": "npm audit --omit=dev --audit-level=moderate --registry=https://registry.npmjs.org",
        "ci": "npm run audit:security && npm run lint && npm run check:worker && npm run test:worker && npm run check:worker-policy && npm run check:extension-policy && npm run check:browser-deps && npm run audit:routes && npm run check:access-config && npm run build && npm run cf:dry-run",
        "cf:dry-run": "npm run build && wrangler deploy --dry-run",
        "deploy": "npm run build && wrangler deploy"
    },
    "dependencies": {
        "@adobe/css-tools": "^4.4.4",
        "@iconfu/svg-inject": "^1.2.3",
        "@mozilla/readability": "^0.6.0",
        "@popperjs/core": "^2.11.8",
        "bowser": "^2.12.1",
        "chalk": "^5.6.0",
        "chevrotain": "^13.2.0",
        "diff-match-patch": "^1.0.5",
        "dompurify": "^3.4.2",
        "droll": "^0.2.1",
        "fflate": "^0.8.2",
        "fuse.js": "^7.1.0",
        "handlebars": "^4.7.9",
        "highlight.js": "^11.11.1",
        "jose": "^6.2.9",
        "js-sha256": "^0.11.1",
        "localforage": "^1.10.0",
        "lodash": "^4.18.1",
        "moment": "^2.30.1",
        "morphdom": "^2.7.7",
        "seedrandom": "^3.0.5",
        "showdown": "https://codeload.github.com/showdownjs/showdown/tar.gz/d1a8d16344b855ea2f37677ee8a9e0cc2c597ea4",
        "slidetoggle": "^4.0.0",
        "yaml": "^2.8.3"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.22.0",
        "@cloudflare/workers-types": "^5.20260821.1",
        "@types/node": "^22.18.0",
        "esbuild": "^0.28.1",
        "eslint": "^8.57.1",
        "eslint-plugin-jsdoc": "^48.10.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0",
        "webpack": "^5.105.4",
        "wrangler": "^4.125.0"
    }
}
